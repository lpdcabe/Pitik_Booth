PORT=5000
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PHOTO_RETENTION_DAYS=7

# Booth Together uses these same server-only Supabase credentials for private
# Realtime Broadcast/Presence, PostgreSQL room commands, and private stills.
# Apply supabase/booth-together.sql after supabase/migration.sql.
# No frontend Supabase key or additional backend environment variable is needed.
# Rooms expire after 2 hours; schedule npm run cleanup -w backend for removal.
