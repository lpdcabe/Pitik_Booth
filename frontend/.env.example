VITE_API_URL=http://localhost:5000

# Booth Together ICE configuration. Comma-separated URLs are supported.
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_DEBUG_WEBRTC=false

# All VITE_ values are public in the built frontend, including TURN credentials.
# Use dedicated limited relay credentials, or extend the API for short-lived TURN.
# Never add SUPABASE_SERVICE_ROLE_KEY or a TURN provider management key here.
